{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1/[...path]"
    },
    {
      "source": "/:slug",
      "destination": "/public-card/index.html"
    }
  ]
}
