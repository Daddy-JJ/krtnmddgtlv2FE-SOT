# Vercel server-side proxy origin. HTTPS origin only; do not add /api/v1.
BACKEND_API_BASE_URL=https://api.kartunamadigital.id

# Public browser configuration injected into the static build/dev server.
# Do not put credentials, tokens, or other secrets in this file.
PUBLIC_API_BASE_URL_LOCAL=http://127.0.0.1:3000/api/v1
PUBLIC_API_BASE_URL_PRODUCTION=https://api.kartunamadigital.id/api/v1
PUBLIC_API_TIMEOUT_MS=30000
